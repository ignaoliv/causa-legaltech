{
  "trailingSlash": true,
  "redirects": [
    { "source": "/historia.html", "destination": "/donna/historia.html", "permanent": true },
    { "source": "/legaltech-argentina.html", "destination": "/donna/legaltech-argentina.html", "permanent": true },
    { "source": "/prd-fuero-legaltech.html", "destination": "/donna/prd-fuero-legaltech.html", "permanent": true },
    { "source": "/fuero-artifacts.html", "destination": "/donna/fuero-artifacts.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/og/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/rss.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    }
  ]
}
